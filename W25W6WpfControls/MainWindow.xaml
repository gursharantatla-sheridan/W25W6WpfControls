<Window x:Class="W25W6WpfControls.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:W25W6WpfControls"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" FontSize="16" FontWeight="Bold">
    <Canvas>
        <UniformGrid Height="64" Width="88" Canvas.Left="694" Canvas.Top="71" Background="#FFFFFDD0">
            <Button Content="Button 1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Button Content="Button 2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </UniformGrid>
        <Image Height="39" Canvas.Left="705" Canvas.Top="19" Width="66" Source="/Car.png"/>
        <GroupBox Height="138" Header="Cities" Width="152" Canvas.Left="34" Canvas.Top="25" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Canvas>
                <CheckBox x:Name="chkToronto" Content="Toronto" Canvas.Left="10" Canvas.Top="10"/>
                <CheckBox x:Name="chkParis" Content="Paris" Canvas.Left="10" Canvas.Top="34" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <CheckBox x:Name="chkTokyo" Content="Tokyo" Canvas.Left="10" Canvas.Top="59" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <CheckBox x:Name="chkSydney" Content="Sydney" Canvas.Left="10" Canvas.Top="84" HorizontalAlignment="Center" VerticalAlignment="Top"/>
            </Canvas>
        </GroupBox>
        <Button x:Name="btnGetCities" Content="Get Cities" Canvas.Left="191" Canvas.Top="38" Height="34" Width="105" HorizontalAlignment="Left" VerticalAlignment="Center" Click="btnGetCities_Click"/>
        <Label x:Name="lblOutput" Canvas.Left="558" Canvas.Top="283" Height="103" Width="213" Background="#FFB6F4F5"/>

        <GroupBox Height="138" Header="Gender" Width="152" Canvas.Left="34" Canvas.Top="181" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Canvas>
                <RadioButton x:Name="rdoFemale" Content="Female" Canvas.Left="10" Canvas.Top="10"/>
                <RadioButton x:Name="rdoMale" Content="Male" Canvas.Left="10" Canvas.Top="45" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <RadioButton x:Name="rdoOther" Content="Other" Canvas.Left="10" Canvas.Top="79" HorizontalAlignment="Center" VerticalAlignment="Top"/>

            </Canvas>
        </GroupBox>
        <Button x:Name="btnGetGender" Content="Get Gender" Canvas.Left="191" Canvas.Top="193" Height="34" Width="105" HorizontalAlignment="Center" VerticalAlignment="Top" Click="btnGetGender_Click"/>
        <Label Content="Province" Canvas.Left="34" Canvas.Top="346" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <ComboBox x:Name="cmbProvince" Canvas.Left="114" Canvas.Top="348" Width="120" SelectionChanged="cmbProvince_SelectionChanged">
            <ComboBoxItem Content="Ontario"/>
            <ComboBoxItem Content="Quebec"/>
            <ComboBoxItem Content="Manitoba"/>
            <ComboBoxItem Content="Alberta"/>
        </ComboBox>
        <Button x:Name="btnGetProvince" Content="Get Province" Canvas.Left="244" Canvas.Top="345" Height="34" Width="104" HorizontalAlignment="Left" VerticalAlignment="Top" Click="btnGetProvince_Click"/>
        <ListBox Height="216" Width="174" Canvas.Left="371" Canvas.Top="38">
            <ListBoxItem Content="Mercury" />
            <ListBoxItem Content="Venus" />
            <ListBoxItem Content="Earth" />
            <ListBoxItem Content="Mars" />
        </ListBox>
        <Button x:Name="btnShowWin2" Content="Show Win 2" Canvas.Left="584" Canvas.Top="163" Height="64" Width="154" Click="btnShowWin2_Click"/>

    </Canvas>
</Window>
